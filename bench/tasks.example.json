[
  {
    "id": "authorization-map",
    "prompt": "Trace authorization for course import. Identify the entry point, checks, and any missing role check. Do not edit files.",
    "reset": ["git checkout -- . && git clean -fdq"],
    "baseline_command": "claude -p --output-format json --max-turns 12 \"$(cat bench/prompts/authorization-map-baseline.txt)\"",
    "broker_command": "claude -p --output-format json --max-turns 12 \"$(cat bench/prompts/authorization-map-broker.txt)\"",
    "checks": ["git diff --quiet && test -z \"$(git status --porcelain)\""]
  }
]
