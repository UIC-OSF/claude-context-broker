#!/usr/bin/env python3
"""Quick Context Broker screening estimate.

Compares what a capped Read would actually put into the primary context (at most
2,000 lines per file, lines truncated at 2,000 characters, as Claude Code's Read
tool does) with the worker summary, and reports the worker's own usage and cost.
This is a compression ratio for one question. It is not a cost saving: the primary
session still performs follow-up targeted reads, which are not measured here.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

READ_MAX_LINES = 2000
READ_MAX_LINE_CHARS = 2000
PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or Path(__file__).resolve().parents[1])


def estimate_tokens(byte_count: int) -> int:
    return max(1, round(byte_count / 4))  # rough, model-agnostic proxy; not billing data


def capped_read_bytes(path: Path) -> int:
    total = 0
    with path.open("rb") as handle:
        for index, line in enumerate(handle):
            if index >= READ_MAX_LINES:
                break
            total += min(len(line), READ_MAX_LINE_CHARS)
    return total


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--question", required=True)
    parser.add_argument("--paths", nargs="+", required=True)
    args = parser.parse_args()

    paths = [Path(v) for v in args.paths]
    missing = [str(p) for p in paths if not p.is_file()]
    if missing:
        print(f"benchmark: not regular files: {', '.join(missing)}", file=sys.stderr)
        return 2
    raw_bytes = sum(p.stat().st_size for p in paths)
    read_bytes = sum(capped_read_bytes(p) for p in paths)

    command = [str(PLUGIN_ROOT / "scripts" / "repo-read"), "--question", args.question, "--paths", *args.paths]
    began = time.monotonic()
    result = subprocess.run(command, text=True, capture_output=True)
    elapsed = time.monotonic() - began
    if result.returncode:
        print(result.stderr.strip() or "benchmark: worker failed", file=sys.stderr)
        return result.returncode

    worker = {}
    for line in result.stderr.splitlines():
        try:
            worker = json.loads(line).get("context_broker_worker", {}) or worker
        except json.JSONDecodeError:
            continue
    summary_bytes = len(result.stdout.encode())
    read_tokens, summary_tokens = estimate_tokens(read_bytes), estimate_tokens(summary_bytes)
    ratio = (1 - summary_tokens / read_tokens) * 100 if read_tokens else 0.0
    usage = worker.get("usage") or {}

    print("Context Broker screening estimate (summary compression, not cost saving)")
    print(f"Files analysed:                   {len(paths)}")
    print(f"Raw source on disk:               {raw_bytes:,} bytes")
    print(f"What a capped Read would return:  {read_bytes:,} bytes (~{read_tokens:,} tokens)")
    print(f"Worker summary returned:          {summary_bytes:,} bytes (~{summary_tokens:,} tokens)")
    print(f"Primary-context compression:      {ratio:.0f}% for this one question")
    print(f"Worker model:                     {worker.get('model', 'unknown')}")
    print(f"Worker tokens (in/cache-write/out): {usage.get('input_tokens', '?')} / {usage.get('cache_creation_input_tokens', 0)} / {usage.get('output_tokens', '?')}")
    cost = worker.get("total_cost_usd")
    print(f"Worker cost:                      {'$' + format(cost, '.4f') if isinstance(cost, (int, float)) else 'not reported by worker'}")
    print(f"Worker elapsed time:              {elapsed:.1f}s")
    print("\nNot measured: the follow-up targeted reads the primary session will still make,")
    print("or whether the primary session would have read these files in full at all.")
    print("Use bench/ for a paired comparison before claiming savings.")
    print("\nWorker output:\n")
    print(result.stdout.rstrip())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
